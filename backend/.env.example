# ── Deployment identity and data ──────────────────────────────────
# CITY_CONFIG, CITY_PRESET, CITY_CONFIG_DIR, CITY_DATA_DIR and STATIC_DIR are
# read from the process environment only. Set them in the shell (or as Docker
# build args / compose variables), NOT in this file: the frontend build reads
# the CITY_* ones too, and the backend refuses to start if this file sets them.
#   CITY_CONFIG      config file under config/ (e.g. presets/my-city.json); unset = config/city.config.json
#   CITY_PRESET      shorthand for CITY_CONFIG=presets/<id>.json (CITY_CONFIG wins)
#   CITY_DATA_DIR    data pack directory; unset = app/data (Austin); relative = under config/
#   CITY_CONFIG_DIR  backend only: directory holding city.config.json when not ./config or /app/config
#   STATIC_DIR       built frontend to serve from FastAPI (the Docker image sets it)
# FORWARDED_ALLOW_IPS (proxy IPs for X-Forwarded-*) is read by the Docker CMD.

# API title and version in the OpenAPI docs. Default title: "<city config appName> API".
# APP_NAME=
# APP_VERSION=1.0.0

# ── OpenAI (primary AI provider) ──────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5-2026-04-23
OPENAI_REASONING_EFFORT=medium
# Effort for plan ordering (POST /intake/plan), which the resident waits on
# after the intake. Demo personas skip the model and use the rules order.
OPENAI_PLAN_REASONING_EFFORT=low
# Cap on tool-call rounds inside one assistant turn (safety net)
OPENAI_MAX_TOOL_ITERATIONS=6

# ── Voice privacy ─────────────────────────────────────────────────
# intercepted_text (default): the browser transcribes speech on-device,
# scrubs PII, and sends text through the normal chat path. No audio leaves
# the device. realtime_audio: raw microphone audio is streamed to the OpenAI
# Realtime API. Only for deployments with an OpenAI zero-data-retention
# agreement; it also needs ALLOW_RAW_AUDIO_STREAM=true and live AI on.
# Any other VOICE_PIPELINE_MODE value stops the app at startup.
VOICE_PIPELINE_MODE=intercepted_text
ALLOW_RAW_AUDIO_STREAM=false

# Realtime voice intake (only used when VOICE_PIPELINE_MODE=realtime_audio;
# the browser uses ephemeral client secrets)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# low is OpenAI's recommended starting point for voice agents (faster replies).
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_SECRET_TTL_SECONDS=600
# Local troubleshooting trace for Realtime voice sessions. This includes
# short transcript previews, so keep it disabled or protected in production.
# Defaults to off; set to true only when actively debugging locally.
REALTIME_DEBUG_LOG_ENABLED=false
REALTIME_DEBUG_LOG_PATH=logs/realtime_debug.jsonl

# ── App behavior ──────────────────────────────────────────────────
# When true, intake uses the scripted fallback regardless of the key.
DEMO_MODE=false
# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Public origin used to build shareable URLs (QR codes, SMS/email links)
PUBLIC_ORIGIN=http://localhost:5173

# ── Admin ─────────────────────────────────────────────────────────
# Shared secret required (as the X-Admin-Token header) for admin catalog
# writes: POST/PATCH/DELETE /api/v1/admin/services. Leave empty to refuse
# all writes (403). Admin GET routes stay open; they serve synthetic data.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# ── Abuse defense and cost guardrails (app/defense/, SECURITY.md §10) ──
# false = no rate limits, metering or budgets (the kill switches still apply).
# DEFENSE_ENABLED=true
# Keyed-hash and device-token secrets, 32+ characters each. Unset: random per
# process. DEFENSE_TOKEN_SECRET is required on Vercel/Railway when the
# proof-of-work challenge is on (no ACCESS_CODES).
# DEFENSE_HASH_KEY=
# DEFENSE_TOKEN_SECRET=
# Proxies in front of the app that append to X-Forwarded-For (Vercel: 1).
# 0 = use the socket peer address and ignore the header.
# DEFENSE_TRUSTED_PROXY_HOPS=0
# Access-code labels get this many times the per-principal limits and budgets.
# DEFENSE_ACCESS_MULTIPLIER=10
# auto = none when ACCESS_CODES is set, else proof of work. Or: none | pow.
# CHALLENGE_PROVIDER=auto
# DEFENSE_POW_BITS=13
# Emergency stops; they need no store.
# KILL_SWITCH_LIVE_AI=false
# KILL_SWITCH_VOICE=false
# KILL_SWITCH_SHARE=false
# Budgets (0 disables one). Dollars are estimates from config/model_prices.json.
# BUDGET_USD_PRINCIPAL_HOUR=2
# BUDGET_USD_PRINCIPAL_DAY=4
# BUDGET_USD_GLOBAL_HOUR=0
# BUDGET_USD_GLOBAL_DAY=15
# BUDGET_USD_GLOBAL_MONTH=18
# BUDGET_TOKENS_PRINCIPAL_HOUR=400000
# BUDGET_TOKENS_PRINCIPAL_DAY=1500000
# BUDGET_TOKENS_GLOBAL_HOUR=20000000
# BUDGET_TOKENS_GLOBAL_DAY=100000000
# BUDGET_VOICE_SECONDS_PRINCIPAL_HOUR=900
# BUDGET_VOICE_SECONDS_PRINCIPAL_DAY=1800
# BUDGET_VOICE_SECONDS_GLOBAL_HOUR=18000
# BUDGET_VOICE_SECONDS_GLOBAL_DAY=72000
# One agent loop stops after this many tokens.
# OPENAI_MAX_TOKENS_PER_TURN=120000
# Realtime voice: each mint reserves the maximum session length.
# REALTIME_MAX_SESSION_SECONDS=600
# REALTIME_IDLE_SECONDS=90
# Any rate-limit row: RL_<POLICY>_<RULE>, e.g. RL_INTAKE_MESSAGE_PRINCIPAL=20
# (0 disables the row). Table in SECURITY.md §10.

# ── Notifications (optional — stubs out without these) ────────────
# Twilio (SMS): https://console.twilio.com/
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555550100
# Country calling codes the SMS share may text (default 1 = US/NANP).
# Example adding the UK: 1,44. Also allow them in Twilio Geo Permissions;
# see SECURITY.md.
# SMS_ALLOWED_COUNTRY_CODES=1
# SendGrid (email): https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@example.invalid
# SENDGRID_FROM_NAME=Your Service Guide  # default: the city config's appName

# ── Azure OpenAI (legacy fallback, optional) ──────────────────────
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
