# ── OpenAI (primary AI provider) ──────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5-2026-04-23
OPENAI_REASONING_EFFORT=medium
# Cap on tool-call rounds inside one assistant turn (safety net)
OPENAI_MAX_TOOL_ITERATIONS=6

# ── Voice privacy ─────────────────────────────────────────────────
# intercepted_text (default): the browser transcribes speech on-device,
# scrubs PII, and sends text through the normal chat path. No audio leaves
# the device. realtime_audio: raw microphone audio is streamed to the OpenAI
# Realtime API. Only for deployments with an OpenAI zero-data-retention
# agreement; it also needs ALLOW_RAW_AUDIO_STREAM=true and live AI on.
# Any other VOICE_PIPELINE_MODE value stops the app at startup.
VOICE_PIPELINE_MODE=intercepted_text
ALLOW_RAW_AUDIO_STREAM=false

# Realtime voice intake (only used when VOICE_PIPELINE_MODE=realtime_audio;
# the browser uses ephemeral client secrets)
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_REASONING_EFFORT=medium
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_SECRET_TTL_SECONDS=600
# Local troubleshooting trace for Realtime voice sessions. This includes
# short transcript previews, so keep it disabled or protected in production.
# Defaults to off; set to true only when actively debugging locally.
REALTIME_DEBUG_LOG_ENABLED=false
REALTIME_DEBUG_LOG_PATH=logs/realtime_debug.jsonl

# ── App behavior ──────────────────────────────────────────────────
# When true, intake uses the scripted fallback regardless of the key.
DEMO_MODE=false
# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Public origin used to build shareable URLs (QR codes, SMS/email links)
PUBLIC_ORIGIN=http://localhost:5173

# ── Admin ─────────────────────────────────────────────────────────
# Shared secret required (as the X-Admin-Token header) for admin catalog
# writes: POST/PATCH/DELETE /api/v1/admin/services. Leave empty to refuse
# all writes (403). Admin GET routes stay open; they serve synthetic data.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# ── Notifications (optional — stubs out without these) ────────────
# Twilio (SMS): https://console.twilio.com/
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15125551234
# SendGrid (email): https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@austin-service-guide.local
# SENDGRID_FROM_NAME=Austin Service Guide

# ── Azure OpenAI (legacy fallback, optional) ──────────────────────
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
