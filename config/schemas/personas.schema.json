{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/personas.schema.json",
  "title": "Demo personas (personas.yaml)",
  "description": "Optional; without it the ?demo=1 launcher offers no personas. Persona id -> persona. Read by app/services/personas.py: seed_profile becomes an app.models.ResidentProfile, script turns become ScriptedTurn. Synthetic demo data only: never a real resident.",
  "type": "object",
  "propertyNames": {"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
  "additionalProperties": {"$ref": "#/$defs/persona"},
  "$defs": {
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"},
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "language", "seed_profile", "opening_message", "persona_note"],
      "properties": {
        "id": {"type": "string", "description": "Must equal the mapping key (the launcher lists id; load-persona looks up the key)."},
        "label": {"type": "string", "minLength": 1, "description": "Launcher button text."},
        "summary": {"type": "string", "description": "One sentence about the person, shown on the launcher card."},
        "shows": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 4, "description": "2-3 short tags naming what the scenario demonstrates."},
        "language": {"$ref": "#/$defs/language", "description": "Conversation language code."},
        "seed_profile": {"$ref": "#/$defs/profile"},
        "opening_message": {"type": "string", "minLength": 1, "description": "The resident's first message."},
        "persona_note": {"type": "string", "description": "Guidance for the model, appended after a fixed note that the seed is a hypothesis."},
        "script": {
          "type": ["array", "null"],
          "description": "Optional scripted dialogue for the no-AI demo flow.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {"enum": ["user", "assistant"]},
              "content": {"type": "string"},
              "delay_ms": {"type": "integer", "minimum": 0, "description": "Typing pause before the bubble. Default 800."}
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "A ResidentProfile (app/models.py). The engine reacts to the values noted; other strings are kept but ignored by matching.",
      "properties": {
        "age_range": {"type": "string", "description": "For example 40s, 30-39, 65+, under 18."},
        "household_size": {"type": ["integer", "null"], "minimum": 1},
        "zip_code": {"type": "string", "pattern": "^([0-9]{5})?$"},
        "housing_situation": {"type": "string", "description": "renting, own_home, unstable, homeless, other."},
        "employment_status": {"type": "string", "description": "full-time, part-time, unemployed, retired, disabled."},
        "income_bracket": {"type": "string", "description": "For example $0-$10,000, $10,000-$20,000, $20,000-$30,000."},
        "insurance_status": {"type": "string", "description": "employer, medicaid, medicare, marketplace, uninsured, unknown."},
        "has_children": {"type": ["boolean", "null"]},
        "veteran_status": {"type": ["boolean", "null"]},
        "has_disability": {"type": ["boolean", "null"]},
        "immediate_needs": {"type": "array", "items": {"type": "string"}, "description": "Lower-case need keywords or category slugs."},
        "languages_spoken": {"type": "array", "items": {"$ref": "#/$defs/language"}},
        "crisis_indicators": {"type": "array", "uniqueItems": true, "items": {"enum": ["domestic_violence", "immediate_danger", "suicidal_ideation", "homelessness"]}},
        "is_outdoor_worker": {"type": ["boolean", "null"]},
        "has_ac": {"type": ["boolean", "null"]},
        "has_chronic_conditions": {"type": ["boolean", "null"]},
        "school_age_children": {"type": "array", "items": {"$ref": "#/$defs/child"}},
        "is_refugee_or_immigrant": {"type": ["boolean", "null"]},
        "primary_language": {"type": "string", "pattern": "^([a-z]{2,3}(-[A-Za-z0-9]+)*)?$"}
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grade": {"type": "string", "description": "K, 1-12."},
        "district": {"type": "string"},
        "concerns": {"type": "array", "items": {"type": "string"}, "description": "Lower-case tags; anxiety, depression, behavioral, self-harm, trauma and mental health raise the child mental-health risk flag."}
      }
    }
  }
}
