{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/brand.schema.json",
  "title": "White-label brand configuration",
  "description": "Branding for one city deployment. The active file is config/brand.config.json; alternates live in config/presets/<name>.brand.json and are selected at build time with CITY_PRESET=<name>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["appName", "shortName", "agencyName", "cityName", "description", "logo", "palette", "darkPalette", "fontFamily", "copy", "contact", "map", "pwa"],
  "properties": {
    "appName": {"type": "string", "minLength": 1, "description": "Full product name, used as page title and PWA name."},
    "shortName": {"type": "string", "minLength": 1, "description": "Short name for home-screen icons (12 characters or fewer recommended)."},
    "agencyName": {"type": "string", "minLength": 1, "description": "Name of the operating health agency."},
    "cityName": {"type": "string", "minLength": 1, "description": "Name of the city served."},
    "description": {"type": "string", "minLength": 1, "description": "One-sentence description for the HTML meta description and PWA manifest."},
    "logo": {
      "type": "object", "additionalProperties": false, "required": ["src", "alt"],
      "description": "Primary logo. The file must exist under frontend/public/.",
      "properties": {
        "src": {"type": "string", "pattern": "^/", "description": "Site-root path to the logo, for example /brand/logo.svg."},
        "alt": {"type": "string", "minLength": 1, "description": "Alternative text for screen readers."}
      }
    },
    "palette": {"$ref": "#/$defs/palette", "description": "Light-mode colors."},
    "darkPalette": {"$ref": "#/$defs/palette", "description": "Dark-mode colors."},
    "fontFamily": {"type": "string", "minLength": 1, "description": "CSS font-family list for all text, for example Geist,Helvetica,sans-serif."},
    "copy": {
      "type": "object", "additionalProperties": false, "required": ["tagline", "footerDisclaimer", "privacyNotice"],
      "properties": {
        "tagline": {"type": "string", "minLength": 1, "description": "Short value statement shown on the landing page."},
        "footerDisclaimer": {"type": "string", "minLength": 1, "description": "Footer line naming the agency and jurisdiction."},
        "privacyNotice": {"type": "string", "minLength": 1, "description": "Notice shown above the chat input telling residents not to enter personal identifiers."}
      }
    },
    "contact": {
      "type": "object", "additionalProperties": false, "required": ["phone311", "agencyWebsite", "accessibilityUrl"],
      "properties": {
        "phone311": {"type": "string", "minLength": 1, "description": "Non-emergency city information line (for example 311)."},
        "agencyWebsite": {"type": "string", "pattern": "^https?://", "description": "Agency home page URL."},
        "accessibilityUrl": {"type": "string", "pattern": "^https?://", "description": "Accessibility statement URL."}
      }
    },
    "map": {
      "type": "object", "additionalProperties": false, "required": ["center", "zoom"],
      "description": "Default map view for the resident and admin maps.",
      "properties": {
        "center": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "[latitude, longitude] of the default map center."},
        "zoom": {"type": "number", "minimum": 1, "maximum": 18, "description": "Default Leaflet zoom level (11 shows a metro area)."}
      }
    },
    "pwa": {
      "type": "object", "additionalProperties": false, "required": ["themeColor", "backgroundColor"],
      "properties": {
        "themeColor": {"$ref": "#/$defs/hex", "description": "Browser toolbar color for the installed app."},
        "backgroundColor": {"$ref": "#/$defs/hex", "description": "Splash-screen background color."}
      }
    }
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Six-digit hex color such as #0F5C6E."},
    "role": {
      "type": "object", "additionalProperties": false, "required": ["main", "light", "dark", "contrastText"],
      "description": "A color role. contrastText must reach WCAG AA contrast (4.5:1) against main.",
      "properties": {
        "main": {"$ref": "#/$defs/hex"}, "light": {"$ref": "#/$defs/hex"},
        "dark": {"$ref": "#/$defs/hex"}, "contrastText": {"$ref": "#/$defs/hex"}
      }
    },
    "palette": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "secondary", "background", "text", "error", "warning", "success", "info"],
      "properties": {
        "primary": {"$ref": "#/$defs/role"},
        "secondary": {"$ref": "#/$defs/role"},
        "background": {"type": "object", "additionalProperties": false, "required": ["default", "paper"], "properties": {"default": {"$ref": "#/$defs/hex"}, "paper": {"$ref": "#/$defs/hex"}}},
        "text": {"type": "object", "additionalProperties": false, "required": ["primary", "secondary"], "properties": {"primary": {"$ref": "#/$defs/hex"}, "secondary": {"$ref": "#/$defs/hex"}}},
        "error": {"$ref": "#/$defs/hex"}, "warning": {"$ref": "#/$defs/hex"},
        "success": {"$ref": "#/$defs/hex"}, "info": {"$ref": "#/$defs/hex"}
      }
    }
  }
}
