# Frontend build-time settings. Copy to frontend/.env (or set in the shell /
# as Docker build args). Every VITE_* value is built into the browser bundle,
# so nothing here is secret.

# Backend origin when the API is not served from the same origin as the SPA.
# Unset = same origin (the Docker image and the Vite dev proxy).
# VITE_API_URL=https://api.example.gov

# Map tiles (docs/CUSTOMIZING.md, "Map"). Unset = OpenStreetMap's public
# tile server. A custom URL needs an attribution, or the build fails.
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
